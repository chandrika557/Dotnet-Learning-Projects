@model IReadOnlyList<ClaimListItemViewModel>

@{
    ViewData["Title"] = "Claims";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1">Claims</h1>
        <p class="text-muted mb-0">Review submitted insurance claims.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Submit Claim</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">No claims have been submitted yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Customer</th><th>Policy</th><th>Claim amount</th>
                    <th>Date</th><th>Reason</th><th>Status</th><th>Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td>@claim.CustomerName</td>
                        <td>@claim.PolicyName</td>
                        <td>@claim.ClaimAmount.ToString("C")</td>
                        <td>@claim.ClaimDate.ToLocalTime().ToString("d")</td>
                        <td>@claim.Reason</td>
                        <td><span class="badge text-bg-secondary">@claim.Status</span></td>
                        <td>
                            @if (claim.Status == ClaimStatus.Pending)
                            {
                                <div class="d-flex gap-2">
                                    <form asp-action="Approve" asp-route-id="@claim.ClaimId" method="post">
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@claim.ClaimId" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Processed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
