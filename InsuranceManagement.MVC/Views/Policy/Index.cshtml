@model IReadOnlyList<PolicyListItemViewModel>

@{
    ViewData["Title"] = "Policies";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1">Policies</h1>
        <p class="text-muted mb-0">@Model.Count policy/policies</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Policy</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">No policies yet. Add a customer, then create their first policy.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Policy name</th>
                    <th>Type</th>
                    <th>Customer</th>
                    <th>Coverage</th>
                    <th>Premium</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var policy in Model)
                {
                    <tr>
                        <td>@policy.PolicyName</td>
                        <td>@policy.PolicyType</td>
                        <td>@policy.CustomerName</td>
                        <td>@policy.CoverageAmount.ToString("C")</td>
                        <td>@policy.PremiumAmount.ToString("C")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details" asp-route-id="@policy.PolicyId" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Edit" asp-route-id="@policy.PolicyId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@policy.PolicyId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
