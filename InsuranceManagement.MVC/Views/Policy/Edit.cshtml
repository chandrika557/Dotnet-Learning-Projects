@model PolicyFormViewModel

@{
    ViewData["Title"] = "Edit Policy";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header"><h1 class="h4 mb-0">Edit Policy</h1></div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        @if (Model.CanChangeCustomer)
                        {
                            <label asp-for="CustomerId" class="form-label"></label>
                            <select asp-for="CustomerId" asp-items="Model.CustomerOptions" class="form-select"></select>
                        }
                        else
                        {
                            <input asp-for="CustomerId" type="hidden" />
                            <label class="form-label">Customer</label>
                            <p class="form-control-plaintext">
                                @Model.CustomerOptions.FirstOrDefault(customer => customer.Value == Model.CustomerId.ToString())?.Text
                                (cannot be changed after a claim is submitted)
                            </p>
                        }
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PolicyName" class="form-label"></label>
                        <input asp-for="PolicyName" class="form-control" />
                        <span asp-validation-for="PolicyName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PolicyType" class="form-label"></label>
                        <select asp-for="PolicyType" asp-items="Html.GetEnumSelectList<PolicyType>()" class="form-select">
                            <option value="">-- Select a type --</option>
                        </select>
                        <span asp-validation-for="PolicyType" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CoverageAmount" class="form-label"></label>
                        <input asp-for="CoverageAmount" type="number" min="0.01" step="0.01" class="form-control" />
                        <span asp-validation-for="CoverageAmount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PremiumAmount" class="form-label"></label>
                        <input asp-for="PremiumAmount" type="number" min="0.01" step="0.01" class="form-control" />
                        <span asp-validation-for="PremiumAmount" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
