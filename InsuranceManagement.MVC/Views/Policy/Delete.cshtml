@model PolicyDetailsViewModel

@{
    ViewData["Title"] = "Delete Policy";
}

<div class="card border-danger shadow-sm">
    <div class="card-header text-bg-danger"><h1 class="h4 mb-0">Delete Policy</h1></div>
    <div class="card-body">
        @if (Model.HasClaims)
        {
            <div class="alert alert-warning">This policy has claims and cannot be deleted.</div>
        }
        else
        {
            <p>Are you sure you want to delete this policy?</p>
        }
        <dl class="row">
            <dt class="col-sm-3">Policy</dt><dd class="col-sm-9">@Model.PolicyName</dd>
            <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.CustomerName</dd>
            <dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.PolicyType</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.PolicyId" method="post">
            @if (!Model.HasClaims)
            {
                <button type="submit" class="btn btn-danger">Delete Policy</button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
